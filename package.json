{
	"name": "averlo-next-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"footprint:generate": "node scripts/generate-repository-footprint.mjs",
		"catalog:generate": "node scripts/generate-component-catalog.mjs",
		"catalog:check": "node scripts/generate-component-catalog.mjs --check",
		"design-system:evidence": "node scripts/record-design-system-evidence.mjs",
		"predev": "npm run catalog:generate",
		"predev:local": "npm run catalog:generate",
		"predev:inspect": "npm run catalog:generate",
		"prebuild": "npm run catalog:generate",
		"dev": "node scripts/dev-server.mjs preview --random --prewarm",
		"dev:local": "node scripts/dev-server.mjs local",
		"dev:inspect": "node scripts/dev-server.mjs preview --random --prewarm --inspect",
		"dev:thin": "node scripts/dev-thin.mjs",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "biome check",
		"typecheck": "tsc --noEmit --pretty false",
		"verify:static": "npm run lint && npm run verify:modals && npm run verify:surface-contracts && npm run verify:retired-semantic-service && npm run verify:retired-template-intelligence && npm run verify:skill-references && npm run typecheck",
		"verify:build": "npm run build",
		"verify:smoke": "node scripts/verify/verify-smoke.mjs",
		"verify:auth": "tsx scripts/verify/verify-auth-organization.ts",
		"verify:dashboard-pages": "tsx scripts/verify/verify-dashboard-page-policy.ts",
		"verify:dashboard": "tsx scripts/verify/verify-dashboard-surfaces.ts && npm run verify:dashboard-pages",
		"verify:assistant": "tsx scripts/verify/verify-assistant.ts",
		"verify:platform": "tsx scripts/verify/verify-platform-operations.ts",
		"verify:modals": "node scripts/verify/verify-modal-system.mjs",
		"verify:surface-contracts": "node scripts/verify/verify-surface-contracts.mjs",
		"verify:retired-semantic-service": "node scripts/verify/verify-retired-semantic-service.mjs",
		"verify:retired-template-intelligence": "node scripts/verify/verify-retired-template-intelligence.mjs",
		"verify:skill-references": "node --test scripts/verify/verify-skill-references.test.mjs && node scripts/verify/verify-skill-references.mjs",
		"verify:route-surfaces": "tsx scripts/verify/verify-route-surfaces.ts",
		"verify:marketing-sections": "tsx scripts/verify/verify-marketing-section-policy.ts",
		"verify:site-layout": "tsx scripts/verify/verify-marketing-site-layout.ts",
		"verify:payload-site-layout": "tsx scripts/verify/verify-payload-site-layout-source.ts",
		"verify:reference-entities": "tsx scripts/verify/verify-reference-entities.ts",
		"verify:entity-deletion": "tsx scripts/verify/verify-entity-deletion.ts",
		"verify:mutation-policy": "tsx scripts/verify/verify-mutation-policy.ts",
		"verify:entity-skeletons": "tsx scripts/verify/verify-entity-skeletons.ts",
		"verify:component-skeletons": "tsx scripts/verify/verify-component-skeletons.ts",
		"verify:route-skeletons": "tsx scripts/verify/verify-route-skeletons.ts",
		"verify:frontend-entity-policy": "tsx scripts/verify/verify-frontend-entity-policy.ts",
		"verify:frontend-entities": "npm run verify:reference-entities && npm run verify:entity-deletion && npm run verify:mutation-policy && npm run verify:entity-skeletons && npm run verify:route-skeletons && npm run verify:frontend-entity-policy",
		"verify:profiles": "node scripts/verify/verify-template-profiles.mjs",
		"verify:create-averlo": "node scripts/verify/verify-create-averlo.mjs",
		"measure:scroll-performance": "node scripts/scroll-performance/measure.mjs",
		"record:scroll-performance": "node scripts/scroll-performance/record.mjs",
		"setup:scroll-performance-autoresearch": "node scripts/scroll-performance/setup-autoresearch.mjs",
		"score:scroll-performance": "node scripts/scroll-performance/score-candidate.mjs",
		"verify:scroll-performance": "node --test scripts/scroll-performance/lib/scroll-performance.test.mjs",
		"verify": "npm run verify:static && npm run verify:build && npm run verify:smoke",
		"format": "biome format --write",
		"create:project": "node scripts/create-template-profile.mjs",
		"review:thin-start-api": "node scripts/review-thin-start-api.mjs",
		"postinstall": "node scripts/pin-deps.mjs",
		"postbuild": "node scripts/postbuild.mjs",
		"payload:seed:site-layout": "tsx scripts/payload/site-layout-backfill.ts --seed",
		"payload:verify:site-layout": "tsx scripts/payload/site-layout-backfill.ts --verify",
		"storybook": "npm run storybook:preview",
		"storybook:preview": "node scripts/storybook-preview.mjs ensure",
		"storybook:status": "node scripts/storybook-preview.mjs status",
		"storybook:stop": "node scripts/storybook-preview.mjs stop",
		"verify:storybook-preview": "node scripts/verify/verify-storybook-preview.mjs",
		"measure:storybook-performance": "node scripts/measure-storybook-performance.mjs",
		"build-storybook": "storybook build && tsx scripts/storybook-build-provenance.ts",
		"test-storybook": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism --passWithNoTests",
		"test-storybook:ui:light": "STORYBOOK_TEST_APPEARANCE=light vitest run --project storybook src/components/ui --maxWorkers=1 --no-file-parallelism",
		"test-storybook:ui:dark": "STORYBOOK_TEST_APPEARANCE=dark vitest run --project storybook src/components/ui --maxWorkers=1 --no-file-parallelism",
		"test-storybook:ui": "npm run test-storybook:ui:light && npm run test-storybook:ui:dark",
		"verify:storybook-catalog": "npm run build-storybook && tsx scripts/verify/verify-storybook-catalog.ts",
		"verify:component-sweep": "tsx scripts/verify/verify-component-sweep.ts",
		"verify:design-system-evidence": "node scripts/verify/verify-design-system-evidence.mjs",
		"verify:storybook-backport": "node --test plugins/averlo/skills/storybook-backport/tests/scan-story-backports.test.mjs",
		"verify:design-system-agent-benchmark": "node scripts/verify/verify-design-system-agent-benchmark.mjs",
		"generate:design-system-agent-benchmark-report": "node scripts/verify/verify-design-system-agent-benchmark.mjs --write"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.23",
		"@ai-sdk/react": "^4.0.44",
		"@mdxeditor/editor": "4.1.0",
		"@payloadcms/db-postgres": "3.86.0",
		"@payloadcms/next": "3.86.0",
		"@payloadcms/richtext-lexical": "3.86.0",
		"@payloadcms/storage-vercel-blob": "3.86.0",
		"@phosphor-icons/react": "^2.1.10",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-hotkeys": "^0.10.0",
		"ai": "^7.0.41",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"libphonenumber-js": "^1.12.33",
		"micromark": "4.0.2",
		"micromark-extension-directive": "3.0.2",
		"micromark-extension-mdx-jsx": "3.0.1",
		"micromark-extension-mdx-md": "2.0.0",
		"motion": "^12.23.24",
		"next": "^16.2.11",
		"next-sitemap": "^4.2.3",
		"payload": "3.86.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-phone-number-input": "^3.4.14",
		"recharts": "^3.10.1",
		"remark-gfm": "^4.0.1",
		"sharp": "0.35.3",
		"sonner": "^2.0.7",
		"streamdown": "^2.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@chromatic-com/storybook": "^5.2.1",
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-vitest": "^10.5.5",
		"@storybook/nextjs-vite": "^10.5.5",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^25.8.0",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"code-inspector-plugin": "^1.5.1",
		"js-tiktoken": "^1.0.21",
		"playwright": "^1.61.1",
		"storybook": "^10.5.5",
		"tailwindcss": "^4.1.12",
		"tsx": "4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		},
		"js-yaml": "4.3.0",
		"monaco-editor": {
			"dompurify": "3.4.12"
		},
		"next": {
			"postcss": "8.5.22",
			"sharp": "0.35.3"
		},
		"uuid": "11.1.1"
	}
}

{
	"description": "Continue an active Averlo Compose task at a closed section boundary.",
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/hooks/compose-stop-hook.mjs\"",
						"timeout": 10,
						"statusMessage": "Continuing the next Compose section"
					}
				]
			}
		]
	}
}

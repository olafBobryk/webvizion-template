{
	"name": "create-averlo",
	"version": "0.1.0",
	"description": "Create an Averlo project from a pinned positive-assembly profile.",
	"type": "module",
	"bin": {
		"create-averlo": "bin/create-averlo.mjs"
	},
	"files": [
		"bin",
		"dist/template-metadata.json",
		"lib",
		"LICENSE",
		"README.md"
	],
	"scripts": {

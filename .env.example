# Canonical server-side origin for metadata and sitemap generation.
# SITE_URL=https://example.com

# Dashboard support mailto destination. The support fixture form never sends email.
# SUPPORT_EMAIL=support@example.com

# Optional production password-recovery delivery through Resend.
# APP_ORIGIN=https://example.com
# RESEND_API_KEY=
# PASSWORD_RESET_FROM="Averlo <security@example.com>"
# Optional Assistant runtime: fixture, openai, or the development-only
# codex_harness. An empty value preserves OPENAI_API_KEY auto-selection.
ASSISTANT_RUNTIME=
ASSISTANT_CODEX_MODEL=
ASSISTANT_CODEX_TIMEOUT_MS=45000
ASSISTANT_CODEX_LIFECYCLE_DELAY_MS=90

# Keep fallback for static and Payload-ready projects. Switch to payload only
# after the site-layout global has been seeded and its readback has passed.
MARKETING_CONTENT_SOURCE=fallback

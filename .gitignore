# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/.next-user/
/.next-user-*/
/.next-preview-*/
/.next-agent-*/
/tsconfig.next-*.json
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# local agent/worktree metadata
/.codex/*
!/.codex/hooks.json
/.worktrees/
/.template-instances/
/tmp/
/.thin-start/
/.understand-anything/
/graphify-out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
